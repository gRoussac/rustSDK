# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

## any pem Key
*.pem

.env
.github_credentials
.cursor

# Desktop Electron installers - ship via GitHub Releases only, never commit
examples/desktop/electron/release/*
!examples/desktop/electron/release/.gitkeep
desktop/electron/release/*
!desktop/electron/release/.gitkeep
*.AppImage
*.snap
**/electron/release/*.exe
**/electron/release/*.zip
**/electron/release/*.blockmap
**/electron/release/builder-debug.yml
